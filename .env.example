# Copy to .env and export (e.g. `set -a; source .env; set +a`) before starting the server.
SANDBOX_BACKEND=docker          # docker (production) | process (dev/CI only, Linux)
SANDBOX_POLICY=warn             # off | warn | block   (static pre-flight check)
SANDBOX_MEMORY_MB=128
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=64
SANDBOX_DEFAULT_TIMEOUT=5
SANDBOX_MAX_TIMEOUT=15
SANDBOX_MAX_CONCURRENT=4
SANDBOX_RATE_LIMIT_PER_MIN=30
SANDBOX_IMAGE=airlock-runner:latest
# SANDBOX_DOCKER_RUNTIME=runsc  # run containers under gVisor if installed
# SANDBOX_API_KEY=change-me     # require X-API-Key on /api/execute and /api/stats
